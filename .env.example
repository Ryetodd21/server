# Environment Variables — Server Backend
# Copy ke .env dan isi nilai sebenarnya sebelum production.
#
# Generate SECRET_KEY: python3 -c "import secrets; print(secrets.token_hex(32))"
#
# ─────────────────────────────────────────────────────────────────────────────
# MODE OPERASIONAL
# ─────────────────────────────────────────────────────────────────────────────
# MODE=dev            Default — SQLite + fakeredis + --reload (development)
# MODE=prod           Production — PostgreSQL + Redis + multi-worker
#                     Script run-server.sh akan refuse start kalau prasyarat
#                     MODE=prod tidak terpenuhi.
# UVICORN_WORKERS=4   Jumlah uvicorn worker (default: 1 dev, 4 prod)
# RQ_WORKERS=2        Jumlah rq worker (default: 0 dev, 2 prod)

# ─────────────────────────────────────────────────────────────────────────────
# CORS — daftar origin yang diizinkan (comma-separated, tanpa spasi)
# ─────────────────────────────────────────────────────────────────────────────
# Development:
#   http://localhost:3000,http://127.0.0.1:3000
# Production (contoh untuk tunnel Cloudflare):
#   https://monitorung.example.com,https://www.monitorung.example.com
# Multiple origins OK. WAJIB pakai https:// untuk production (cookie secure).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — production WAJIB PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
# Development (SQLite, auto):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATABASE_SYNC_URL=sqlite:///./dev.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/monitoring_distraksi
# DATABASE_SYNC_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/monitoring_distraksi

# ─────────────────────────────────────────────────────────────────────────────
# REDIS — production WAJIB real Redis (bukan fake://...)
# ─────────────────────────────────────────────────────────────────────────────
# Development (fakeredis, in-memory):
REDIS_URL=fake://localhost:6379/0
USE_FAKEREDIS=true
# Production (real Redis):
# REDIS_URL=redis://localhost:6379/0
# USE_FAKEREDIS=false

# ─────────────────────────────────────────────────────────────────────────────
# JWT — REQUIRED, generate ulang untuk production
# ─────────────────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Minimal 32 chars. Jangan pakai value dari file ini di production.
SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# DEBUG — WAJIB false di production
# ─────────────────────────────────────────────────────────────────────────────
# Mengontrol: SQL echo, cookie secure flag, error detail di response.
# Production: DEBUG=false
DEBUG=false

# ─────────────────────────────────────────────────────────────────────────────
# ML Pipeline
# ─────────────────────────────────────────────────────────────────────────────
PCA_N_COMPONENTS=2
KMEANS_N_CLUSTERS=3

# ─────────────────────────────────────────────────────────────────────────────
# Jadwal WITA (UTC+8)
# ─────────────────────────────────────────────────────────────────────────────
LOG_START_HOUR=7
LOG_END_HOUR=22
CUTOFF_HOUR=22
TRAINING_HOUR=23

# ─────────────────────────────────────────────────────────────────────────────
# MQTT Broker
# ─────────────────────────────────────────────────────────────────────────────
# Production: pakai broker yang reliable (e.g. Mosquitto di VPS atau managed service)
MQTT_BROKER_URL=tcp://localhost:1883
